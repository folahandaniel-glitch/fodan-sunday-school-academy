# Names only. Never commit real values. Copy to .env.local for development.
# --- Core (required in production) ---
DATABASE_URL=                 # PostgreSQL (Neon / Vercel Postgres / Supabase). Leave empty locally to use the embedded database.
AUTH_SECRET=                  # 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_URL=http://localhost:3000 # public base URL (emails, payment callbacks, certificate links)
SUPERADMIN_EMAIL=             # used by `npm run admin:bootstrap`
# --- Email (needed for password reset / notifications to actually send) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # must be on a domain verified in Resend
# --- Payments (needed before charging churches) ---
PAYSTACK_SECRET_KEY=          # sk_test_... / sk_live_...
# --- Operations ---
CRON_SECRET=                  # protects /api/cron/maintenance
DATABASE_POOL_MAX=5
# --- Optional ---
FSSA_DATA_DIR=                # where the embedded dev database lives (default: ~/.fodan-sunday-school-academy)
FSSA_AUTOSEED_CONTENT=        # set to 0 to skip curriculum seeding at runtime (production seeds at build time)
