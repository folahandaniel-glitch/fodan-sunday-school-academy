{
  "name": "fodan-sunday-school-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Fodan Sunday School Academy: multi-church Sunday school curriculum, scheduling and CBT examination platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "brand:assets": "node scripts/brand-assets.mjs",
    "content:report": "node --conditions=react-server --import tsx scripts/content-report.ts",
    "admin:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:seed": "node --conditions=react-server --import tsx scripts/db-seed.ts",
    "registry": "node scripts/gen-registry.mjs",
    "vercel-build": "node scripts/gen-registry.mjs && node --conditions=react-server --import tsx scripts/db-seed.ts && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
